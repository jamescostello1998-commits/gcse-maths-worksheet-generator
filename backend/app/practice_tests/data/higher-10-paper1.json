      "topic_id": "algebraic_inverse_proportion",
      "prompt": "y is inversely proportional to x^2. When x = 2, y = 54. Find the value of y when x = 3.",
      "solution_steps": [
        "y = k ÷ x^2",
        "k = y × x^2 = 54 × 2^2 = 54 × 4 = 216",
        "y = k ÷ x^2 = 216 ÷ 3^2 = 216 ÷ 9 = 24"
      ],
      "final_answer": "24",
      "marks": 4,
      "mark_scheme": [
