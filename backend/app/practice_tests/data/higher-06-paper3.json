      "topic_id": "angles_polygon_interior_H",
      "prompt": "A polygon has 6 sides. 5 of its interior angles are each 110°, and the remaining interior angle is (4x + 154)°. Find x.",
      "solution_steps": [
        "Sum of interior angles = (n - 2) × 180 = (6 - 2) × 180 = 720°",
        "Sum of the 5 equal angles = 5 × 110 = 550°",
        "Remaining angle = 720 - 550 = 170°",
        "4x + 154 = 170",
        "Subtract 154 from both sides:",
        "4x = 16",
        "Divide both sides by 4:",
        "x = 4"
      ],
      "final_answer": "4",
      "marks": 5,
      "mark_scheme": [
        {
          "code": "M1",
          "description": "Sum of interior angles = (n - 2) × 180 = (6 - 2) × 180 = 720°",
          "marks": 1
        },
